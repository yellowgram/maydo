# Migrator (superuser). Migrations and `maydo admin bootstrap` only.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/maydo

# Runtime roles. Neither is BYPASSRLS.
DATABASE_URL_API=postgres://maydo_api:maydo_api_dev@127.0.0.1:5432/maydo
DATABASE_URL_WORKER=postgres://maydo_worker:maydo_worker_dev@127.0.0.1:5432/maydo

MAYDO_TENANT_ID=
# Local only. Founding deploy: openssl rand -hex 32, NODE_ENV=production,
# MAYDO_REQUIRE_PRODUCTION=1, and do not set MAYDO_ALLOW_INSECURE_DEV_SECRETS.
MAYDO_KEY_PEPPER=dev-pepper-change-me
MAYDO_ALLOW_INSECURE_DEV_SECRETS=1
# openssl rand -hex 32 — do not commit a real secret.
MAYDO_SESSION_SECRET=
# NODE_ENV=production
# MAYDO_REQUIRE_PRODUCTION=1
# MAYDO_TRUST_PROXY=1
MAYDO_STATUS_URL=https://status.yellowgram.dev/maydo

API_PORT=3040
CONSOLE_PORT=3041

# Pending audit rows per tenant before allow-decisions are sampled at 1%.
# Denies are always enqueued.
AUDIT_DEGRADE_DEPTH=1000
ALLOW_RATE_PER_MIN=600
